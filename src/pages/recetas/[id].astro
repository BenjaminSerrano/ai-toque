---
import Icono from '../../components/Icono.astro';
import LineaIngrediente from '../../components/LineaIngrediente.astro';
import Layout from '../../layouts/Layout.astro';
import { comprasDeReceta, obtenerReceta } from '../../lib/db.ts';
import { agrupar, separarCantidad } from '../../lib/formato.ts';
import { sitio as nombreSitio } from '../../lib/importar.ts';

const id = Number(Astro.params.id);
const receta = obtenerReceta(id);
if (!receta) return Astro.rewrite('/404');

const ingredientes = agrupar(receta.ingredientes);
const pasos = agrupar(receta.pasos);
const sitio = nombreSitio(receta.url);
const yaGuardada = Astro.url.searchParams.has('ya');

// Modo comprar: se marca lo que falta y queda una lista guardada para toda la casa.
const comprando = Astro.url.searchParams.has('comprar');
const compras = comprasDeReceta(id);
// Una línea repetida en dos grupos ("1 huevo" en la masa y en el relleno) se compra una vez.
const paraComprar = [...new Set(ingredientes.flatMap((grupo) => grupo.lineas))];
const pendientes = paraComprar.filter((linea) => compras.get(linea) === false).length;
const textoCompra = (linea: string) => {
	const { nombre, cantidad } = separarCantidad(linea);
	return cantidad ? `${nombre} — ${cantidad}` : nombre;
};
const claseModo =
	'rounded-md px-2 py-2 font-semibold decoration-amarillo decoration-[3px] underline-offset-[10px] hover:underline';

let ingrediente = 0;
let numero = 0;
---

<Layout title={receta.titulo}>
	<a href="/" class="inline-flex items-center gap-2 py-2 font-semibold text-tiza/80 hover:text-tiza">
		<Icono nombre="volver" />
		Menú de la casa
	</a>

	{
		yaGuardada && (
			<p role="status" class="aviso mt-4">
				<Icono nombre="info" class="mt-0.5 size-6 shrink-0 text-celeste" />
				Ya tenías esta receta en el recetario.
			</p>
		)
	}

	<article class="mt-6" data-receta={id}>
		<header class="grid gap-8 lg:grid-cols-[minmax(0,1fr)_minmax(0,1.1fr)] lg:items-end">
			<div>
				<h1 class="tiza text-[clamp(3.5rem,8vw,6rem)]">{receta.titulo}</h1>
				<ul class="mt-5 flex flex-wrap gap-x-6 gap-y-2 text-tiza/85">
					{
						receta.porciones && (
							<li class="flex items-center gap-2">
								<Icono nombre="porciones" class="size-5 text-tiza/70" />
								{receta.porciones}
							</li>
						)
					}
					{
						receta.tiempo && (
							<li class="flex items-center gap-2">
								<Icono nombre="reloj" class="size-5 text-tiza/70" />
								{receta.tiempo}
							</li>
						)
					}
					{
						sitio && (
							<li>
								<a href={receta.url} class="enlace inline-flex items-center gap-1.5" rel="noreferrer">
									{sitio}
									<Icono nombre="externo" class="size-4" />
								</a>
							</li>
						)
					}
				</ul>
				<a href={`/recetas/${id}/editar`} class="boton-secundario mt-7">
					<Icono nombre="lapiz" />
					Editar
				</a>
			</div>
			{
				receta.imagen && (
					<img
						src={receta.imagen}
						alt=""
						referrerpolicy="no-referrer"
						class="aspect-[4/3] w-full rounded-2xl bg-pizarra-clara object-cover sm:aspect-[16/10]"
					/>
				)
			}
		</header>

		<div class="mt-14 grid grid-cols-[minmax(0,1fr)] gap-14 lg:grid-cols-[minmax(0,5fr)_minmax(0,6fr)] lg:gap-20">
			<section
				aria-labelledby="ingredientes-titulo"
				class="lg:sticky lg:top-6 lg:max-h-[calc(100dvh-3rem)] lg:self-start lg:overflow-y-auto lg:pr-2"
			>
				<div class="flex flex-wrap items-end justify-between gap-x-4 gap-y-1">
					<h2 id="ingredientes-titulo" class="tiza text-6xl">Ingredientes</h2>
					{
						paraComprar.length > 0 && (
							<nav aria-label="Ingredientes para" class="flex items-center gap-2">
								<a
									href={`/recetas/${id}#ingredientes-titulo`}
									class:list={[claseModo, !comprando && 'underline']}
									aria-current={comprando ? undefined : 'page'}
								>
									Cocinar
								</a>
								<a
									href={`/recetas/${id}?comprar#ingredientes-titulo`}
									class:list={[claseModo, comprando && 'underline']}
									aria-current={comprando ? 'page' : undefined}
								>
									Comprar<span class="tabular-nums" data-cuenta>{pendientes > 0 && ` (${pendientes})`}</span>
								</a>
							</nav>
						)
					}
				</div>
				{
					ingredientes.length === 0 && (
						<p class="mt-4 text-tiza/75">
							Sin ingredientes anotados. <a href={`/recetas/${id}/editar`} class="enlace">Agrégalos</a>.
						</p>
					)
				}
				{
					comprando && paraComprar.length > 0 && (
						<p class="mt-3 text-base text-tiza/75">Marca lo que te falta. La lista queda guardada para toda la casa.</p>
					)
				}
				{
					ingredientes.map((grupo) => (
						<>
							{grupo.titulo && <h3 class="tiza mt-8 text-4xl text-tiza/90">{grupo.titulo}</h3>}
							<ul class="mt-3">
								{grupo.lineas.map((linea) => (
									<li>
										{comprando ? (
											<label class="flex cursor-pointer items-start gap-4 py-2.5">
												<input type="checkbox" class="mt-1" data-falta value={linea} checked={compras.has(linea)} />
												<LineaIngrediente linea={linea} />
											</label>
										) : (
											<label class="marcable flex cursor-pointer items-start gap-4 py-2.5">
												<input type="checkbox" class="mt-1" data-marca={`i${ingrediente++}`} />
												<LineaIngrediente linea={linea} />
											</label>
										)}
									</li>
								))}
							</ul>
						</>
					))
				}

				{
					comprando && paraComprar.length > 0 && (
						<div class="trazo mt-10 p-5 sm:p-6" data-lista-compras data-titulo={receta.titulo}>
							<h3 class="tiza text-4xl">Para comprar</h3>
							<p class="mt-2 text-base text-tiza/75" data-vacia hidden={compras.size > 0}>
								Todavía no hay nada. Marca arriba lo que te falta.
							</p>
							<p class="mt-2 text-base text-tiza/75" data-ayuda hidden={compras.size === 0}>
								Marca lo que vayas comprando.
							</p>
							<ul class="mt-2">
								{paraComprar.map((linea) => (
									<li hidden={!compras.has(linea)} data-texto={textoCompra(linea)}>
										<label class="marcable flex cursor-pointer items-start gap-4 py-2.5">
											<input type="checkbox" class="mt-1" data-comprado value={linea} checked={compras.get(linea) === true} />
											<LineaIngrediente linea={linea} />
										</label>
									</li>
								))}
							</ul>
							<div class="mt-5 flex flex-wrap items-center gap-x-5 gap-y-3" data-acciones hidden={compras.size === 0}>
								<button type="button" class="boton-secundario" data-compartir>
									Compartir la lista
								</button>
								<span role="status" class="text-base text-tiza/80" data-aviso />
								<form method="post" action={`/recetas/${id}/compras`} class="ml-auto">
									<input type="hidden" name="accion" value="vaciar" />
									<button type="submit" class="inline-flex items-center gap-2 py-2 text-base font-semibold text-tiza/80 hover:text-tiza">
										<Icono nombre="borrar" class="size-4" />
										Vaciar la lista
									</button>
								</form>
							</div>
							<p role="alert" class="aviso mt-5" data-error hidden>
								<Icono nombre="info" class="mt-0.5 size-6 shrink-0 text-celeste" />
								<span>
									No se pudo guardar el último cambio. <a href="" class="enlace">Recarga la página</a> para ver la lista como
									está.
								</span>
							</p>
						</div>
					)
				}
			</section>

			<section aria-labelledby="pasos-titulo">
				<div class="flex flex-wrap items-end justify-between gap-x-4 gap-y-1">
					<h2 id="pasos-titulo" class="tiza text-6xl">Preparación</h2>
					<button type="button" data-desmarcar class="hidden items-center gap-2 py-2 text-base font-semibold whitespace-nowrap text-tiza/80 hover:text-tiza">
						<Icono nombre="borrar" class="size-4" />
						Desmarcar todo
					</button>
				</div>
				{
					pasos.length === 0 && (
						<p class="mt-4 text-tiza/75">
							Sin pasos anotados. <a href={`/recetas/${id}/editar`} class="enlace">Agrégalos</a>.
						</p>
					)
				}
				{
					pasos.map((grupo) => (
						<>
							{grupo.titulo && <h3 class="tiza mt-8 text-4xl text-tiza/90">{grupo.titulo}</h3>}
							<ol class="mt-3" start={numero + 1}>
								{grupo.lineas.map((linea) => {
									numero += 1;
									return (
										<li class="paso">
											<label class="marcable grid cursor-pointer grid-cols-[3.75rem_minmax(0,1fr)] gap-x-4 py-4 sm:grid-cols-[5rem_minmax(0,1fr)] sm:gap-x-5">
												<span
													class="numero tiza row-span-2 text-right text-[5rem] leading-[0.8] text-tiza/90 tabular-nums transition-colors sm:text-[6rem]"
													aria-hidden="true"
												>
													{numero}
												</span>
												<span class="max-w-[62ch] text-xl leading-relaxed">
													<span class="tachable">{linea}</span>
												</span>
												<span class="mt-3 flex items-center gap-2 text-base text-tiza/75">
													<input type="checkbox" class="size-6" data-marca={`p${numero}`} />
													Listo
												</span>
											</label>
										</li>
									);
								})}
							</ol>
						</>
					))
				}
			</section>
		</div>

		{
			receta.notas && (
				<section aria-labelledby="notas-titulo" class="trazo mt-16 max-w-3xl p-6 sm:p-8">
					<h2 id="notas-titulo" class="tiza text-5xl">Notas</h2>
					<p class="mt-3 whitespace-pre-line text-xl leading-relaxed">{receta.notas}</p>
				</section>
			)
		}
	</article>
</Layout>

<style>
	/* El paso en curso (el primero sin marcar) lleva el número en tiza amarilla. */
	.paso[data-en-curso] .numero {
		color: var(--color-amarillo);
	}
</style>

<script>
	const articulo = document.querySelector<HTMLElement>('[data-receta]');

	// Cocinar: recuerda lo marcado mientras dure la sesión (si el celular se bloquea, no se pierde)
	// y señala el paso en curso. Cada casilla tiene su clave (i3, p2) para no mezclarse con el modo comprar.
	if (articulo) {
		const clave = `ai-toque:marcas:${articulo.dataset.receta}`;
		const casillas = [...articulo.querySelectorAll<HTMLInputElement>('input[data-marca]')];
		const desmarcar = document.querySelector<HTMLButtonElement>('[data-desmarcar]');

		const leer = (): Record<string, boolean> => {
			try {
				const marcas = JSON.parse(sessionStorage.getItem(clave) ?? '{}');
				return marcas && typeof marcas === 'object' && !Array.isArray(marcas) ? marcas : {};
			} catch {
				return {};
			}
		};
		const actualizar = () => {
			const pasos = [...articulo.querySelectorAll<HTMLElement>('.paso')];
			const enCurso = pasos.find((paso) => !paso.querySelector('input')?.checked);
			for (const paso of pasos) paso.toggleAttribute('data-en-curso', paso === enCurso);
			const alguna = casillas.some((c) => c.checked);
			desmarcar?.classList.toggle('hidden', !alguna);
			desmarcar?.classList.toggle('inline-flex', alguna);
			try {
				const marcas = leer();
				for (const casilla of casillas) marcas[casilla.dataset.marca!] = casilla.checked;
				sessionStorage.setItem(clave, JSON.stringify(marcas));
			} catch {
				// Sin almacenamiento disponible: las marcas solo duran hasta recargar.
			}
		};

		const marcas = leer();
		for (const casilla of casillas) casilla.checked = marcas[casilla.dataset.marca!] === true;
		articulo.addEventListener('change', (evento) => {
			if ((evento.target as HTMLElement).matches('[data-marca]')) actualizar();
		});
		desmarcar?.addEventListener('click', () => {
			for (const casilla of casillas) casilla.checked = false;
			try {
				sessionStorage.removeItem(clave);
			} catch {
				// Nada guardado que borrar.
			}
			actualizar();
		});
		actualizar();
	}

	// Comprar: cada cambio se guarda al tiro en el recetario, para toda la casa.
	const lista = document.querySelector<HTMLElement>('[data-lista-compras]');
	if (articulo && lista) {
		const ruta = `/recetas/${articulo.dataset.receta}/compras`;
		const faltas = [...articulo.querySelectorAll<HTMLInputElement>('input[data-falta]')];
		const items = [...lista.querySelectorAll<HTMLLIElement>('li[data-texto]')];
		const casillaDe = (item: HTMLLIElement) => item.querySelector<HTMLInputElement>('input[data-comprado]')!;
		const parte = (nombre: string) => lista.querySelector<HTMLElement>(`[data-${nombre}]`)!;
		const cuenta = document.querySelector<HTMLElement>('[data-cuenta]');

		const pintar = () => {
			const enLista = new Set(faltas.filter((c) => c.checked).map((c) => c.value));
			for (const item of items) {
				item.hidden = !enLista.has(casillaDe(item).value);
				if (item.hidden) casillaDe(item).checked = false;
			}
			const visibles = items.filter((item) => !item.hidden);
			const pendientes = visibles.filter((item) => !casillaDe(item).checked).length;
			parte('vacia').hidden = visibles.length > 0;
			parte('ayuda').hidden = visibles.length === 0;
			parte('acciones').hidden = visibles.length === 0;
			if (cuenta) cuenta.textContent = pendientes ? ` (${pendientes})` : '';
		};

		// Los cambios se envían en orden, uno tras otro, para que el último toque sea el que queda.
		let cola = Promise.resolve();
		const guardar = (accion: 'falta' | 'comprado', casilla: HTMLInputElement) => {
			const datos = new FormData();
			datos.set('accion', accion);
			datos.set('linea', casilla.value);
			datos.set('valor', casilla.checked ? '1' : '0');
			cola = cola.then(async () => {
				try {
					const respuesta = await fetch(ruta, { method: 'POST', body: datos });
					if (respuesta.status !== 204) throw new Error(`Respuesta ${respuesta.status}`);
				} catch {
					parte('error').hidden = false;
				}
			});
		};

		articulo.addEventListener('change', (evento) => {
			const casilla = evento.target as HTMLInputElement;
			if (casilla.matches('[data-falta]')) {
				// La misma línea puede estar en dos grupos: se marcan juntas.
				for (const otra of faltas) if (otra.value === casilla.value) otra.checked = casilla.checked;
				pintar();
				guardar('falta', casilla);
			} else if (casilla.matches('[data-comprado]')) {
				pintar();
				guardar('comprado', casilla);
			}
		});

		// Compartir lo que falta comprar (WhatsApp u otra app); si el navegador no puede, se copia.
		const aviso = parte('aviso');
		let ultimoAviso = '';
		let temporizador: number | undefined;
		const avisar = (mensaje: string) => {
			// VoiceOver no repite un mensaje idéntico: un espacio invisible lo hace distinto.
			const texto = mensaje === ultimoAviso ? `${mensaje} ` : mensaje;
			ultimoAviso = texto;
			clearTimeout(temporizador);
			aviso.textContent = '';
			requestAnimationFrame(() => (aviso.textContent = texto));
			temporizador = window.setTimeout(() => (aviso.textContent = ''), 2500);
		};
		parte('compartir').addEventListener('click', async () => {
			const faltan = items.filter((item) => !item.hidden && !casillaDe(item).checked).map((item) => `• ${item.dataset.texto}`);
			if (faltan.length === 0) return avisar('Ya está todo comprado.');
			const texto = `Para comprar (${lista.dataset.titulo}):\n${faltan.join('\n')}`;
			if (navigator.share) {
				try {
					await navigator.share({ text: texto });
					return;
				} catch (error) {
					if ((error as DOMException).name === 'AbortError') return;
				}
			}
			try {
				await navigator.clipboard.writeText(texto);
				avisar('Lista copiada.');
			} catch {
				avisar('No se pudo copiar.');
			}
		});

		// Al volver con "atrás", recargar: alguien de la casa pudo cambiar la lista mientras tanto.
		addEventListener('pageshow', (evento) => {
			if (evento.persisted) location.reload();
		});
	}
</script>

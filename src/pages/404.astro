---
import Layout from '../layouts/Layout.astro';
---

<Layout title="No encontrada">
	<div class="trazo mx-auto mt-6 max-w-xl p-10 text-center">
		<h1 class="tiza text-6xl">Eso no está en la pizarra</h1>
		<p class="mt-4 text-xl text-tiza/80">Puede que la receta se haya borrado o que el link esté incompleto.</p>
		<a href="/" class="boton mt-8">Volver al menú de la casa</a>
	</div>
</Layout>

---
// Íconos dibujados a mano en un solo trazo (24 × 24, línea de 2 px, puntas redondas).
const TRAZOS = {
	volver: '<path d="M19 12H5"/><path d="m11 18-6-6 6-6"/>',
	lapiz: '<path d="M4 20h4L19 9l-4-4L4 16v4Z"/><path d="m13.5 6.5 4 4"/>',
	externo: '<path d="M14 4h6v6"/><path d="M20 4 10 14"/><path d="M19 14v5a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1V6a1 1 0 0 1 1-1h5"/>',
	info: '<circle cx="12" cy="12" r="9"/><path d="M12 11v5"/><path d="M12 8h.01"/>',
	lupa: '<circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/>',
	pegar: '<rect x="5" y="4" width="14" height="17" rx="2"/><path d="M9 4V3h6v1"/><path d="M9 11h6M9 15h4"/>',
	basura: '<path d="M4 7h16"/><path d="M10 11v6M14 11v6"/><path d="m6 7 1 13h10l1-13"/><path d="M9 7V4h6v3"/>',
	reloj: '<circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/>',
	porciones: '<path d="M4 13h16a8 8 0 0 1-16 0Z"/><path d="M12 13V8"/><path d="M9 5c0 1 1 1 1 2M15 5c0 1-1 1-1 2"/>',
	borrar: '<path d="M3 12a9 9 0 1 0 3-6.7L3 8"/><path d="M3 3v5h5"/>',
} as const;

interface Props {
	nombre: keyof typeof TRAZOS;
	class?: string;
}

const { nombre, class: clase = 'size-5' } = Astro.props;
---

<svg
	class={clase}
	viewBox="0 0 24 24"
	fill="none"
	stroke="currentColor"
	stroke-width="2"
	stroke-linecap="round"
	stroke-linejoin="round"
	aria-hidden="true"
	set:html={TRAZOS[nombre]}
/>
